# Copy to .env and fill in real values. All five keys are required at startup.

# TMDB API read access token (v4 auth) — https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=

# Supabase project — Dashboard > Project Settings > API
SUPABASE_URL=
# Publishable (anon) key. Safe to ship in the binary; RLS is the security
# boundary. The SECRET key must never appear in this repo.
SUPABASE_PUBLISHABLE_KEY=

# Google Sign-In OAuth client IDs — Google Cloud Console > Credentials
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
